# Set these on the backend host to the public frontend URL(s), without path/query.
# CORS_ORIGINS accepts a comma-separated list; CLIENT_URL is also used for reset links.
CLIENT_URL=https://www.goldenintels.edu.gh
CORS_ORIGINS=https://www.goldenintels.edu.gh,https://goldenintels.edu.gh

# Required for auto-provisioned parent and learner logins.
# Configure the requested temporary password on the backend host; do not commit it here.
INITIAL_ACCOUNT_PASSWORD=

# Required to deliver password-reset emails. Verify the sending domain in Resend.
# Set these variables on the backend host; do not commit real credentials.
RESEND_API_KEY=
EMAIL_FROM=Golden-Intels International School <noreply@goldenintels.edu.gh>

# Alternative only when using a Gmail account with 2-step verification and an app password.
# RESEND_API_KEY must be unset to use this fallback.
# EMAIL_USER=
# EMAIL_APP_PASSWORD=
