{
  "scripts": {
    "install-server": "npm install --prefix server",
    "prisma:generate:server": "cd server && npx prisma generate --schema=prisma/schema.prisma",
    "build": "npm run install-server && npm run prisma:generate:server"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  }
}
